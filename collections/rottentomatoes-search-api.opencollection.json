{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rotten Tomatoes Detailed Info Search API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "MoviesSearchSearch",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://api.rottentomatoes.com/api/public/v1.0/movies.json",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "The plain text search query to search for a movie. Remember to URI encode this!"
              },
              {
                "name": "page_limit",
                "value": "",
                "type": "query",
                "description": "The amount of movie search results to show per page"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The selected page of movie search results"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}